# Local Compose bootstrap values only. Keep the real .env uncommitted.
MYOTA_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
MYOTA_BOOTSTRAP_ADMIN_PASSWORD=replace-me

# Compose supplies service-specific PostgreSQL URLs and also enables this
# guard. Keep it enabled for any direct local service process as well.
MYOTA_REQUIRE_DURABILITY=1
CORE_DATABASE_URL=postgresql://myota:myota-dev-only@127.0.0.1:5432/myota_core
GEO_DATABASE_URL=postgresql://myota:myota-dev-only@127.0.0.1:5432/myota_geo
