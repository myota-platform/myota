{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Log events per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_namespace=\"myota\"} | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\" | severity_text=~\"${severity:regex}\"[1m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "Warnings and errors per minute",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity_text) (rate({service_namespace=\"myota\"} | severity_text=~\"WARNING|ERROR\" | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\"[5m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Errors by service",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"myota\"} | severity_text=\"ERROR\" | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\"[5m]))",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 4,
      "title": "Recent warnings and failures",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"myota\"} | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\" | severity_text=~\"${severity:regex}\" | severity_text=~\"WARNING|ERROR\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 5,
      "title": "Worker retries and failures",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"myota\"} | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\" | severity_text=~\"${severity:regex}\" | event=~\"job.retry|job.failed\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 6,
      "title": "HTTP 5xx completion events",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "myota-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"myota\"} | service_name=~\"${service:regex}\" | deployment_environment=~\"${environment:regex}\" | severity_text=~\"${severity:regex}\" | event=\"http.request.completed\" | severity_text=\"ERROR\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "myota-loki"
          }
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Loki ingestion rate",
      "description": "Bytes accepted by Loki by OTLP format. Use the 14-day period to project archive growth.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (format) (rate(loki_distributor_bytes_received_total[5m]))",
          "legendFormat": "{{format}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Loki archive bucket size",
      "description": "Logical bytes in the dedicated SeaweedFS myota-loki bucket.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "myota-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "SeaweedFS_s3_bucket_size_bytes{bucket=\"myota-loki\"}",
          "legendFormat": "myota-loki",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "myota",
